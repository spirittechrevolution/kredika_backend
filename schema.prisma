// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String      @id @default(cuid())
  name                  String      @default("")
  email                 String      @unique @default("")
  password              String
  phone                 String      @unique @default("")
  role                  String?     @default("customer")
  businessName          String      @default("")
  businessAddress       String      @default("")
  isActive              String?     @default("active")
  lastLogin             DateTime?
  createdAt             DateTime?   @default(now())
  updatedAt             DateTime?   @default(now()) @updatedAt
  from_OrderItem_seller OrderItem[] @relation("OrderItem_seller")
  from_Customer_user    Customer[]  @relation("Customer_user")
  from_Seller_user      Seller[]    @relation("Seller_user")
}

model Product {
  id                             String              @id @default(cuid())
  name                           String              @default("")
  brand                          String              @default("")
  model                          String              @default("")
  category                       String              @default("")
  description                    String              @default("")
  image                          String              @default("")
  images                         String              @default("")
  sku                            String              @unique @default("")
  stock                          Int?                @default(0)
  isActive                       Boolean             @default(true)
  featured                       Boolean             @default(false)
  cashPrice                      Float
  currency                       String              @default("XOF")
  creditAvailable                Boolean             @default(false)
  creditPrice                    Float?
  downPayment                    Float?
  downPaymentPercentage          Int?
  installmentPlan                String              @default("")
  vendorCommission               String              @default("")
  seller                         Seller?             @relation("Product_seller", fields: [sellerId], references: [id])
  sellerId                       String?             @map("seller")
  createdAt                      DateTime?           @default(now())
  updatedAt                      DateTime?           @default(now()) @updatedAt
  from_OrderItem_product         OrderItem[]         @relation("OrderItem_product")
  from_CreditReservation_product CreditReservation[] @relation("CreditReservation_product")

  @@index([sellerId])
}

model Order {
  id                             String              @id @default(cuid())
  orderNumber                    String              @unique @default("KRD-2025-BGMS5M")
  customer                       Customer?           @relation("Order_customer", fields: [customerId], references: [id])
  customerId                     String?             @map("customer")
  seller                         Seller?             @relation("Order_seller", fields: [sellerId], references: [id])
  sellerId                       String?             @map("seller")
  customerInfo                   String              @default("")
  status                         String?             @default("pending")
  paymentMethod                  String?             @default("cash")
  totalAmount                    Float
  items                          OrderItem[]         @relation("OrderItem_order")
  creditReservations             CreditReservation[] @relation("CreditReservation_order")
  orderDate                      DateTime?           @default(now())
  updatedAt                      DateTime?           @default(now()) @updatedAt
  from_MobileTransaction_order   MobileTransaction[] @relation("MobileTransaction_order")
  from_Notification_relatedOrder Notification[]      @relation("Notification_relatedOrder")

  @@index([customerId])
  @@index([sellerId])
}

model OrderItem {
  id            String   @id @default(cuid())
  order         Order?   @relation("OrderItem_order", fields: [orderId], references: [id])
  orderId       String?  @map("order")
  product       Product? @relation("OrderItem_product", fields: [productId], references: [id])
  productId     String?  @map("product")
  productName   String   @default("")
  productImage  String   @default("")
  quantity      Int      @default(1)
  unitPrice     Float
  totalPrice    Float
  paymentMethod String?  @default("cash")
  seller        User?    @relation("OrderItem_seller", fields: [sellerId], references: [id])
  sellerId      String?  @map("seller")

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model CreditReservation {
  id                     String        @id @default(cuid())
  order                  Order?        @relation("CreditReservation_order", fields: [orderId], references: [id])
  orderId                String?       @map("order")
  product                Product?      @relation("CreditReservation_product", fields: [productId], references: [id])
  productId              String?       @map("product")
  customer               Customer?     @relation("CreditReservation_customer", fields: [customerId], references: [id])
  customerId             String?       @map("customer")
  productSnapshot        String        @default("")
  paymentPlan            String        @default("")
  status                 String?       @default("reserved")
  installments           Installment[] @relation("Installment_creditReservation")
  reservationDate        DateTime?     @default(now())
  firstPaymentDate       DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  notes                  String        @default("")
  updatedAt              DateTime?     @default(now()) @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([customerId])
}

model Installment {
  id                                   String              @id @default(cuid())
  creditReservation                    CreditReservation?  @relation("Installment_creditReservation", fields: [creditReservationId], references: [id])
  creditReservationId                  String?             @map("creditReservation")
  installmentNumber                    Int
  dueDate                              DateTime
  amount                               Float
  status                               String?             @default("pending")
  paidDate                             DateTime?
  paidAmount                           Float?
  paymentMethod                        String?
  transactionReference                 String              @default("")
  notes                                String              @default("")
  from_MobileTransaction_installment   MobileTransaction[] @relation("MobileTransaction_installment")
  from_Notification_relatedInstallment Notification[]      @relation("Notification_relatedInstallment")

  @@index([creditReservationId])
}

model Customer {
  id                              String              @id @default(cuid())
  user                            User?               @relation("Customer_user", fields: [userId], references: [id])
  userId                          String?             @map("user")
  firstName                       String              @default("")
  lastName                        String              @default("")
  phone                           String              @unique @default("")
  email                           String              @unique @default("")
  address                         String              @default("")
  status                          String?             @default("active")
  creditHistory                   String              @default("{\n  \"totalOrders\": 0,\n  \"completedPayments\": 0,\n  \"latePayments\": 0,\n  \"currentActiveCredits\": 0\n}")
  registrationDate                DateTime?           @default(now())
  lastOrderDate                   DateTime?
  orders                          Order[]             @relation("Order_customer")
  creditReservations              CreditReservation[] @relation("CreditReservation_customer")
  createdAt                       DateTime?           @default(now())
  updatedAt                       DateTime?           @default(now()) @updatedAt
  from_MobileTransaction_customer MobileTransaction[] @relation("MobileTransaction_customer")
  from_Notification_customer      Notification[]      @relation("Notification_customer")

  @@index([userId])
}

model MobileTransaction {
  id                    String       @id @default(cuid())
  order                 Order?       @relation("MobileTransaction_order", fields: [orderId], references: [id])
  orderId               String?      @map("order")
  installment           Installment? @relation("MobileTransaction_installment", fields: [installmentId], references: [id])
  installmentId         String?      @map("installment")
  customer              Customer?    @relation("MobileTransaction_customer", fields: [customerId], references: [id])
  customerId            String?      @map("customer")
  amount                Float
  currency              String       @default("XOF")
  provider              String
  customerPhone         String       @default("")
  status                String?      @default("pending")
  providerTransactionId String       @default("")
  paymentType           String
  providerResponse      String       @default("")
  initiatedAt           DateTime?    @default(now())
  completedAt           DateTime?
  createdAt             DateTime?    @default(now())
  updatedAt             DateTime?    @default(now()) @updatedAt

  @@index([orderId])
  @@index([installmentId])
  @@index([customerId])
}

model Seller {
  id                 String    @id @default(cuid())
  user               User?     @relation("Seller_user", fields: [userId], references: [id])
  userId             String?   @map("user")
  businessName       String    @default("")
  contactPerson      String    @default("")
  phone              String    @default("")
  email              String    @unique @default("")
  businessAddress    String    @default("")
  bankDetails        String    @default("")
  status             String?   @default("pending")
  verified           String?   @default("false")
  commissionSettings String    @default("{\n  \"commissionRates\": {\n    \"3\": 0.03,\n    \"6\": 0.05,\n    \"12\": 0.08\n  },\n  \"paymentSchedule\": \"on_completion\"\n}")
  products           Product[] @relation("Product_seller")
  orders             Order[]   @relation("Order_seller")
  registrationDate   DateTime? @default(now())
  notes              String    @default("")
  createdAt          DateTime? @default(now())
  updatedAt          DateTime? @default(now()) @updatedAt

  @@index([userId])
}

model Notification {
  id                   String       @id @default(cuid())
  customer             Customer?    @relation("Notification_customer", fields: [customerId], references: [id])
  customerId           String?      @map("customer")
  type                 String
  title                String       @default("")
  message              String       @default("")
  relatedOrder         Order?       @relation("Notification_relatedOrder", fields: [relatedOrderId], references: [id])
  relatedOrderId       String?      @map("relatedOrder")
  relatedInstallment   Installment? @relation("Notification_relatedInstallment", fields: [relatedInstallmentId], references: [id])
  relatedInstallmentId String?      @map("relatedInstallment")
  status               String?      @default("pending")
  channels             String       @default("{\n  \"sms\": true,\n  \"email\": false,\n  \"push\": false\n}")
  read                 String?      @default("unread")
  scheduledAt          DateTime?
  sentAt               DateTime?
  readAt               DateTime?
  metadata             String       @default("{}")
  createdAt            DateTime?    @default(now())

  @@index([customerId])
  @@index([relatedOrderId])
  @@index([relatedInstallmentId])
}

model PlatformSetting {
  id                          String    @id @default(cuid())
  name                        String    @default("Paramètres par défaut")
  isActive                    String?   @default("true")
  creditEnabled               String?   @default("true")
  mobileMoneyEnabled          String?   @default("true")
  maxCreditDuration           Int?      @default(12)
  minDownPaymentPercentage    Float?    @default(20)
  platformCommissionRates     String    @default("{\n  \"3\": 0.03,\n  \"6\": 0.05,\n  \"12\": 0.08\n}")
  reservationExpiryDays       Int?      @default(3)
  maxActiveCreditsPerCustomer Int?      @default(3)
  mobileMoneyConfig           String    @default("{\n  \"wave\": {\n    \"enabled\": true,\n    \"merchantId\": \"\",\n    \"environment\": \"sandbox\"\n  },\n  \"orangeMoney\": {\n    \"enabled\": true,\n    \"merchantId\": \"\",\n    \"environment\": \"sandbox\"\n  }\n}")
  notificationSettings        String    @default("{\n  \"paymentReminderDays\": [\n    1,\n    3\n  ],\n  \"latePaymentReminderDays\": [\n    1,\n    3,\n    7\n  ],\n  \"defaultNotificationChannels\": [\n    \"sms\"\n  ]\n}")
  description                 String    @default("")
  changeHistory               String    @default("[]")
  lastUpdated                 DateTime? @default(now()) @updatedAt
  createdAt                   DateTime? @default(now())
}
